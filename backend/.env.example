# Kryptolog backend configuration.
#
# Safe by default (audit 2026-10-12 lot 2): production mode, invite-only signup,
# no password anyone else knows. `start_all.sh` copies this file to backend/.env
# on first run and replaces every __GENERATE__ with a fresh random value; do the
# same by hand for any other deployment. For local development you may switch
# KRYPTOLOG_ENV to development (opens /docs, allows an ephemeral JWT secret) and
# KRYPTOLOG_REQUIRE_INVITE to false.

# Origin(s) the SPA is served from. Required in production: CORS uses it, and so
# does the WebSocket Origin check, which accepts everything when it is empty.
ALLOWED_ORIGINS=http://localhost:5173

# Deployment mode. "production" REFUSES TO START unless KRYPTOLOG_JWT_SECRET,
# KRYPTOLOG_REQUIRE_INVITE and ALLOWED_ORIGINS are all set explicitly, and it
# serves no /docs, /redoc or /openapi.json.
KRYPTOLOG_ENV=production

# Compose credentials. docker-compose.yml reads these (run it with
# `--env-file backend/.env`); there is no default to fall back to. Postgres only
# applies POSTGRES_PASSWORD when its volume is first created — see DEPLOYMENT.md
# to rotate it on an existing one.
POSTGRES_PASSWORD=__GENERATE__
REDIS_PASSWORD=__GENERATE__

# Database. Targets the compose Postgres, which listens on 127.0.0.1 only. For an
# external instance: postgresql+psycopg://user:password@db.example.com:5432/kryptolog
DATABASE_URL=postgresql+psycopg://kryptolog:__POSTGRES_PASSWORD__@localhost:5432/kryptolog

# Database the test suite uses (pytest reads it from here). The suite creates and
# drops all tables around every test — NEVER point this at data you care about.
TEST_DATABASE_URL=postgresql+psycopg://kryptolog:__POSTGRES_PASSWORD__@localhost:5432/kryptolog_test

# Reverse proxies whose X-Forwarded-For uvicorn may believe (serve.sh passes this
# to --forwarded-allow-ips). Default 127.0.0.1: nginx on the same host. A proxy
# that is NOT listed here makes every client share the proxy's rate-limit bucket.
TRUSTED_PROXY_IPS=127.0.0.1

# Address uvicorn binds (serve.sh). Loopback: the API is reached through the
# proxy, where TLS, HSTS and the SPA's CSP live. Change only for a proxy on
# another host — and then firewall it.
# KRYPTOLOG_BIND=127.0.0.1

# Redis: shared rate limits, WebSocket fan-out and presence. With it, several
# workers are safe; without it, keep ONE process. Password-protected, loopback.
REDIS_URL=redis://:__REDIS_PASSWORD__@localhost:6379/0
# RATELIMIT_STORAGE_URI=redis://:password@localhost:6379/1

# JWT signing secret (HS256). Forges sessions if leaked. Required in production.
KRYPTOLOG_JWT_SECRET=__GENERATE__

# Access filter. "true": a brand-new identity needs an invite code (mint them with
# `python generate_invites.py`). "false": anyone who reaches the API can register.
# Production requires an explicit choice.
KRYPTOLOG_REQUIRE_INVITE=true

# Per-account storage quota (audit 2026-10-12 K-09). Counted in stored
# characters, inline content and file chunks together. Defaults shown.
# KRYPTOLOG_QUOTA_SECRETS=1000
# KRYPTOLOG_QUOTA_BYTES=1073741824

# Web Push (optional). Generate a VAPID pair to enable notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kryptolog.io
